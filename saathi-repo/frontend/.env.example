# ==========================================
# SAATHI-AI Frontend Environment Configuration
# Copy this file to frontend/.env.local or set in deployment platform (e.g. Vercel)
# ==========================================

# Base URL of the backend FastAPI service
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example (e.g. Render / Railway / Cloud Run):
# NEXT_PUBLIC_API_URL=https://saathi-ai-backend.onrender.com

# Optional WebSocket URL (only needed if separate from NEXT_PUBLIC_API_URL):
# NEXT_PUBLIC_WS_URL=wss://saathi-ai-backend.onrender.com
